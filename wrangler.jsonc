{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailboxes",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"DOMAINS": "example.com",
		"EMAIL_ADDRESSES": []
	},
	// send_email binding removed — uses Resend API instead, which works on Workers Free plan.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailboxes",
			"preview_bucket_name": "mailboxes"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailboxes-db",
			"database_id": "cb53f644-578f-45f2-b4f0-9393158cfd77",
			"preview_database_id": "local",
			"migrations_dir": "migrations"
		}
	]
}
