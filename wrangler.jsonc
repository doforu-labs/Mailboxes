{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailboxes",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {},
	// send_email binding removed — uses Resend API instead, which works on Workers Free plan.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailboxes",
			"preview_bucket_name": "mailboxes"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailboxes-db",
			"database_id": "bce48f1a-88a3-4a57-8cee-a0f0c7a7ac38",
			"preview_database_id": "local",
			"migrations_dir": "migrations"
		}
	]
}
